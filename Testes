import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

public class ValidadorUsuarioTest {

    ValidadorUsuario validador = new ValidadorUsuario();

    // =========================
    // Testes Nome de Usuário
    // =========================

    @Test
    void nomeValido() {
        assertTrue(validador.validarNomeUsuario("Bernardo"));
    }

    @Test
    void nomeMuitoCurto() {
        assertFalse(validador.validarNomeUsuario("ab"));
    }

    @Test
    void nomeMuitoLongo() {
        assertFalse(validador.validarNomeUsuario("abcdefghijklmnopqrstu"));
    }

    @Test
    void nomeNulo() {
        assertFalse(validador.validarNomeUsuario(null));
    }


    // =========================
    // Testes Email
    // =========================

    @Test
    void emailValido() {
        assertTrue(validador.validarEmail("teste@email.com"));
    }

    @Test
    void emailSemArroba() {
        assertFalse(validador.validarEmail("testeemail.com"));
    }

    @Test
    void emailSemDominio() {
        assertFalse(validador.validarEmail("teste@"));
    }

    @Test
    void emailNulo() {
        assertFalse(validador.validarEmail(null));
    }


    // =========================
    // Testes Senha
    // =========================

    @Test
    void senhaValida() {
        assertTrue(validador.validarSenha("Senha123"));
    }

    @Test
    void senhaMuitoCurta() {
        assertFalse(validador.validarSenha("S1a"));
    }

    @Test
    void senhaSemNumeros() {
        assertFalse(validador.validarSenha("SenhaTeste"));
    }

    @Test
    void senhaSemLetras() {
        assertFalse(validador.validarSenha("12345678"));
    }

    @Test
    void senhaNula() {
        assertFalse(validador.validarSenha(null));
    }
}
